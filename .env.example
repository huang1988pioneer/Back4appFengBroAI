# Back4app database settings.
# These values are optional for local development. If they are omitted, the app falls back to browser localStorage.
# Do not commit real keys in .env files.

VITE_BACK4APP_ENDPOINT=https://parseapi.back4app.com
VITE_BACK4APP_APP_ID=your_app_id_here
VITE_BACK4APP_MASTER_KEY=your_master_key_here
